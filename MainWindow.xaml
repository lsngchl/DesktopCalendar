<Window x:Class="DesktopCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DesktopCalendar.Models"
        Title="Desktop Calendar"
        Width="1421"
        Height="684"
        MinWidth="700"
        MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        FontFamily="Segoe UI, Malgun Gothic"
        Foreground="#F4F8FC"
        Activated="Window_Activated"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        StateChanged="Window_StateChanged"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="#01FFFFFF" />
            <Setter Property="Foreground" Value="#EEF8FCFF" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TodayButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#59FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
        </Style>

        <Style x:Key="WeekdayText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B3EAF8FC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CalendarCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Background" Value="#01FFFFFF" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ClipToBounds" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviousMonth}" Value="True">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNextMonth}" Value="True">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Background" Value="#21F1CF4A" />
                    <Setter Property="BorderBrush" Value="#F1CF4A" />
                    <Setter Property="BorderThickness" Value="0,3,0,0" />
                    <Setter Property="Padding" Value="12,6,12,8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DateRow" TargetType="Border">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="DateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF8FCFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSunday}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFB9B1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                    <Setter Property="Foreground" Value="#FFB9D5FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFB9B1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Foreground" Value="#F1CF4A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HolidayText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFB9B1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,1,0,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EventText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MoreText" TargetType="TextBlock" BasedOn="{StaticResource EventText}">
            <Setter Property="Foreground" Value="#B8FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="3,0,0,0" />
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFB9B1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="CalendarShell"
            Background="#6614191E"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="8">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="새로 고침" Click="Refresh_Click" />
                <Separator />
                <MenuItem Header="닫기" Click="Close_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#01FFFFFF"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center">
                            <Run x:Name="MonthRun" FontSize="20" FontWeight="SemiBold" />
                            <Run x:Name="YearRun" FontSize="13" Foreground="#B3F4F8FC" />
                        </TextBlock>
                        <TextBlock x:Name="StatusText"
                                   Style="{StaticResource StatusText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource TodayButton}" Content="오늘" Click="Today_Click" />
                        <Button Style="{StaticResource ToolbarButton}" Content="&#xE76B;" ToolTip="이전 달" Click="Previous_Click" />
                        <Button Style="{StaticResource ToolbarButton}" Content="&#xE76C;" ToolTip="다음 달" Click="Next_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1" Columns="7">
                <TextBlock Text="일" Style="{StaticResource WeekdayText}" Foreground="#CCFFB9B1" />
                <TextBlock Text="월" Style="{StaticResource WeekdayText}" />
                <TextBlock Text="화" Style="{StaticResource WeekdayText}" />
                <TextBlock Text="수" Style="{StaticResource WeekdayText}" />
                <TextBlock Text="목" Style="{StaticResource WeekdayText}" />
                <TextBlock Text="금" Style="{StaticResource WeekdayText}" />
                <TextBlock Text="토" Style="{StaticResource WeekdayText}" Foreground="#CCB9D5FF" />
            </UniformGrid>

            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding Days}"
                          SizeChanged="DaysGrid_SizeChanged">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CalendarDay}">
                        <Border Style="{StaticResource CalendarCell}"
                                MouseLeftButtonDown="DayCell_MouseLeftButtonDown">
                            <StackPanel>
                                <Border Style="{StaticResource DateRow}">
                                    <TextBlock Text="{Binding DayText}"
                                               Style="{StaticResource DateText}" />
                                </Border>
                                <TextBlock Text="{Binding HolidayName}"
                                           Style="{StaticResource HolidayText}" />
                                <ItemsControl ItemsSource="{Binding Events}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:DayEvent}">
                                            <Border Margin="0,0,0,1"
                                                    Padding="3,1"
                                                    CornerRadius="3"
                                                    Background="{Binding Background}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="Dot"
                                                             Width="6"
                                                             Height="6"
                                                             Margin="0,5,5,0"
                                                             VerticalAlignment="Top"
                                                             Fill="{Binding Color}" />
                                                    <TextBlock Grid.Column="1"
                                                               Style="{StaticResource EventText}">
                                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="#A6F4F8FC" /><Run Text="{Binding Title, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAllDay}" Value="True">
                                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MoreText}"
                                           Style="{StaticResource MoreText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
