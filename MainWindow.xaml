<Window x:Class="DesktopCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DesktopCalendar.Models"
        Title="Desktop Calendar"
        Width="1421"
        Height="684"
        MinWidth="700"
        MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        FontFamily="Malgun Gothic"
        Activated="Window_Activated"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        StateChanged="Window_StateChanged"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#01FFFFFF" />
            <Setter Property="Foreground" Value="#EEF8FCFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="#36FFFFFF" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviousMonth}" Value="True">
                    <Setter Property="Background" Value="#26141B20" />
                    <Setter Property="BorderBrush" Value="#24FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNextMonth}" Value="True">
                    <Setter Property="Background" Value="#26141B20" />
                    <Setter Property="BorderBrush" Value="#24FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFF1CF4A" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF8FCFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DD000000" BlurRadius="2" ShadowDepth="1" Opacity="0.85" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSunday}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFB9B1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                    <Setter Property="Foreground" Value="#FFB9D5FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFB9B1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HolidayText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFB9B1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,1,0,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DD000000" BlurRadius="2" ShadowDepth="1" Opacity="0.85" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border x:Name="CalendarShell"
            Background="#1210181E"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            CornerRadius="4">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="닫기" Click="Close_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#20121C22"
                    BorderBrush="#2DFFFFFF"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="8,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarButton}" Content="&lt;" ToolTip="이전 달" Click="Previous_Click" />
                        <Button Style="{StaticResource ToolbarButton}" Content="&gt;" ToolTip="다음 달" Click="Next_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1" Columns="7" Background="#181C2830">
                <TextBlock Text="일요일" Foreground="#FFFFB9B1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="월요일" Foreground="#EAF8FCFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="화요일" Foreground="#EAF8FCFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="수요일" Foreground="#EAF8FCFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="목요일" Foreground="#EAF8FCFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="금요일" Foreground="#EAF8FCFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="토요일" Foreground="#FFB9D5FF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
            </UniformGrid>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CalendarDay}">
                        <Border Style="{StaticResource CalendarCell}">
                            <StackPanel>
                                <TextBlock Text="{Binding DayText}"
                                           Style="{StaticResource DateText}" />
                                <TextBlock Text="{Binding HolidayName}"
                                           Style="{StaticResource HolidayText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
